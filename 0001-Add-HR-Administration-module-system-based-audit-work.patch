+{% extends "base.html" %}
+{% block title %}HR & Administration - {{ firm_name }}{% endblock %}
+{% block content %}
+<div class="page-header"><h1>HR &amp; Administration</h1></div>
+
+<div class="stat-grid">
+  <a href="{{ url_for('hr.list_policies') }}" class="card" style="text-decoration:none;color:inherit;">
+    <h3 class="mt-0">Policies and Procedures</h3>
+    <p class="muted" style="font-size:13px;">The firm's HR policies, procedures, quality control manual and internal forms - browse, download, and (for admins/partners) keep up to date.</p>
+  </a>
+  <a href="{{ url_for('hr.list_timesheets') }}" class="card" style="text-decoration:none;color:inherit;">
+    <h3 class="mt-0">Time Sheets</h3>
+    <p class="muted" style="font-size:13px;">Log your weekly hours in the app (overtime calculated automatically), or download the Excel template and upload it back once filled in.</p>
+  </a>
+  <a href="{{ url_for('hr.project_board') }}" class="card" style="text-decoration:none;color:inherit;">
+    <h3 class="mt-0">Project Management</h3>
+    <p class="muted" style="font-size:13px;">A firm-wide board of every open task across all engagements - who's working on what, due dates, and review status, all in one place.</p>
+  </a>
+  <a href="{{ url_for('hr.planner') }}" class="card" style="text-decoration:none;color:inherit;">
+    <h3 class="mt-0">Planner</h3>
+    <p class="muted" style="font-size:13px;">A firm-wide audit timetable (spot clashing deadlines at a glance) and a staffing grid showing who's booked on what each week.</p>
+  </a>
+</div>
+
+<div class="card">
+  <h3 class="mt-0">Related</h3>
+  <p style="font-size:13.5px;">
+    {% if current_user.role == 'admin' %}<a href="{{ url_for('users.list_users') }}">Team</a> - add/deactivate staff and set roles &middot;{% endif %}
+    <a href="{{ url_for('engagements.list_templates') }}">Checklist Templates</a> - reusable audit programs &middot;
+    <a href="{{ url_for('doc_templates.list_templates') }}">Document Templates</a> - engagement letters, workpapers and more
+  </p>
+</div>
+{% endblock %}
diff --git a/templates/hr/planner.html b/templates/hr/planner.html
new file mode 100644
index 0000000..d142b5a
--- /dev/null
+++ b/templates/hr/planner.html
@@ -0,0 +1,84 @@
+{% extends "base.html" %}
+{% block title %}Planner - {{ firm_name }}{% endblock %}
+{% block content %}
+<div class="page-header">
+  <div>
+    <h1>Planner</h1>
+    <div class="subtitle">Firm-wide audit timetable and staffing allocations.</div>
+  </div>
+</div>
+
+<div class="card">
+  <h3 class="mt-0">Audit timetable</h3>
+  <p class="muted" style="font-size:12.5px;">Every active engagement's key dates, soonest deadline first. A <span class="badge overdue">Clash</span> badge means more than one engagement has a deadline in the same week.</p>
+  {% if timetable %}
+  <table>
+    <thead><tr><th>Engagement</th><th>Client</th><th>Type</th><th>Start</th><th>Period end</th><th>Deadline</th><th>Status</th><th>Partner / Manager</th></tr></thead>
+    <tbody>
+    {% for row in timetable %}
+      {% set e = row.engagement %}
+      <tr>
+        <td><a href="{{ url_for('engagements.view_engagement', engagement_id=e.id) }}">{{ e.title }}</a></td>
+        <td>{{ e.client.name }}</td>
+        <td><span class="badge type-{{ e.type }}">{{ e.type }}</span></td>
+        <td>{{ e.start_date.strftime('%d %b %Y') if e.start_date else '—' }}</td>
+        <td>{{ e.period_end.strftime('%d %b %Y') if e.period_end else '—' }}</td>
+        <td>
+          {{ e.deadline.strftime('%d %b %Y') if e.deadline else '—' }}
+          {% if e.is_overdue %}<span class="badge overdue">Overdue</span>{% endif %}
+          {% if row.clash %}<span class="badge overdue">Clash</span>{% endif %}
+        </td>
+        <td><span class="badge status-{{ e.status|replace(' ', '') }}">{{ e.status }}</span></td>
+        <td>{{ e.partner.name if e.partner else '—' }}{% if e.manager %} / {{ e.manager.name }}{% endif %}</td>
+      </tr>
+    {% endfor %}
+    </tbody>
+  </table>
+  {% else %}
+  <div class="empty-state">No active engagements to show.</div>
+  {% endif %}
+</div>
+
+<div class="card">
+  <div class="page-header" style="margin-bottom:10px;">
+    <h3 class="mt-0">Staffing grid</h3>
+    <div>
+      <a href="{{ url_for('hr.planner', start=prev_start, weeks=num_weeks) }}" class="btn small secondary">&larr; Previous {{ num_weeks }} weeks</a>
+      <a href="{{ url_for('hr.planner') }}" class="btn small secondary">Today</a>
+      <a href="{{ url_for('hr.planner', start=next_start, weeks=num_weeks) }}" class="btn small secondary">Next {{ num_weeks }} weeks &rarr;</a>
+    </div>
+  </div>
+  <p class="muted" style="font-size:12.5px;">Booked % of each staff member's time per week, from the Staffing section on each engagement's Overview tab. <span class="badge overdue">Red</span> means over 100% booked that week; a blank cell means fully available.</p>
+  {% if people %}
+  <table>
+    <thead>
+      <tr>
+        <th>Staff</th>
+        {% for w in weeks %}<th>{{ w.strftime('%d %b') }}</th>{% endfor %}
+      </tr>
+    </thead>
+    <tbody>
+    {% for person in people %}
+      <tr>
+        <td>{{ person.name }}</td>
+        {% for cell in grid[person.id] %}
+        <td style="font-size:12px;">
+          {% if cell.allocations %}
+            {% for a in cell.allocations %}
+              <div><a href="{{ url_for('engagements.view_engagement', engagement_id=a.engagement_id) }}">{{ a.engagement.title }}</a> ({{ a.allocation_pct }}%)</div>
+            {% endfor %}
+            {% if cell.total_pct > 100 %}<span class="badge overdue">{{ cell.total_pct }}%</span>{% endif %}
+          {% else %}
+            <span class="muted">Available</span>
+          {% endif %}
+        </td>
+        {% endfor %}
+      </tr>
+    {% endfor %}
+    </tbody>
+  </table>
+  {% else %}
+  <div class="empty-state">No active staff to show.</div>
+  {% endif %}
+</div>
+{% endblock %}
diff --git a/templates/hr/policies_list.html b/templates/hr/policies_list.html
new file mode 100644
index 0000000..6d64a9a
--- /dev/null
+++ b/templates/hr/policies_list.html
@@ -0,0 +1,47 @@
+{% extends "base.html" %}
+{% block title %}Policies and Procedures - {{ firm_name }}{% endblock %}
+{% block content %}
+<div class="page-header">
+  <div>
+    <h1>Policies and Procedures</h1>
+    <div class="subtitle">The firm's HR policies, procedures, quality control manual and internal forms.</div>
+  </div>
+  {% if can_edit %}
+  <a href="{{ url_for('hr.new_policy') }}" class="btn gold">+ New Policy / Procedure</a>
+  {% endif %}
+</div>
+
+{% for category, items in library.items() %}
+<div class="card">
+  <h3 class="mt-0"><span class="badge">{{ category }}</span></h3>
+  <table>
+    <thead><tr><th>Name</th><th>Description</th><th>Format</th><th>Last updated</th><th></th></tr></thead>
+    <tbody>
+      {% for policy in items %}
+      <tr>
+        <td>{{ policy.title }}</td>
+        <td class="muted">{{ policy.description }}</td>
+        <td>{{ policy.file_ext|upper }}</td>
+        <td class="muted">{{ policy.updated_at.strftime('%d %b %Y') if policy.updated_at else '—' }}{% if policy.updated_by %} by {{ policy.updated_by.name }}{% endif %}</td>
+        <td class="text-right">
+          <a href="{{ url_for('hr.download_policy', policy_id=policy.id) }}" class="btn small secondary">Download</a>
+          {% if can_edit %}
+          <a href="{{ url_for('hr.edit_policy', policy_id=policy.id) }}" class="btn small secondary">Edit</a>
+          <form method="post" action="{{ url_for('hr.delete_policy', policy_id=policy.id) }}" style="display:inline;" onsubmit="return confirm('Delete this policy/procedure? This cannot be undone.');">
+            <button type="submit" class="btn small danger">Delete</button>
+          </form>
+          {% endif %}
+        </td>
+      </tr>
+      {% endfor %}
+    </tbody>
+  </table>
+</div>
+{% endfor %}
+
+{% if not library %}
+<div class="card">
+  <p class="muted">No policies or procedures added yet.{% if can_edit %} Click "+ New Policy / Procedure" above to add the first one.{% endif %}</p>
+</div>
+{% endif %}
+{% endblock %}
diff --git a/templates/hr/policy_form.html b/templates/hr/policy_form.html
new file mode 100644
index 0000000..6659efc
--- /dev/null
+++ b/templates/hr/policy_form.html
@@ -0,0 +1,32 @@
+{% extends "base.html" %}
+{% block title %}{% if policy %}Edit Policy{% else %}New Policy{% endif %} - {{ firm_name }}{% endblock %}
+{% block content %}
+<div class="page-header">
+  <h1>{% if policy %}Edit {{ policy.title }}{% else %}New Policy / Procedure{% endif %}</h1>
+</div>
+<div class="card" style="max-width:640px;">
+  <form method="post" enctype="multipart/form-data">
+    <label for="category">Category *</label>
+    <select id="category" name="category" required>
+      {% for c in categories %}
+      <option value="{{ c }}" {% if policy and policy.category == c %}selected{% elif not policy and c == 'Other' %}selected{% endif %}>{{ c }}</option>
+      {% endfor %}
+    </select>
+
+    <label for="title">Name *</label>
+    <input type="text" id="title" name="title" value="{{ policy.title if policy else '' }}" required>
+
+    <label for="description">Description</label>
+    <textarea id="description" name="description">{{ policy.description if policy else '' }}</textarea>
+
+    <label for="file">{% if policy %}Replace file (leave blank to keep the current one){% else %}File (PDF, Word, Excel or PowerPoint) *{% endif %}</label>
+    <input type="file" id="file" name="file" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx" {% if not policy %}required{% endif %}>
+    {% if policy %}
+    <p class="muted" style="font-size:12.5px;">Current file: {{ policy.filename }}</p>
+    {% endif %}
+
+    <button type="submit" class="btn gold">{% if policy %}Save changes{% else %}Add to library{% endif %}</button>
+    <a href="{{ url_for('hr.list_policies') }}" class="btn secondary">Cancel</a>
+  </form>
+</div>
+{% endblock %}
diff --git a/templates/hr/timesheet_detail.html b/templates/hr/timesheet_detail.html
new file mode 100644
index 0000000..ab1d4dd
--- /dev/null
+++ b/templates/hr/timesheet_detail.html
@@ -0,0 +1,85 @@
+{% extends "base.html" %}
+{% block title %}Timesheet - {{ firm_name }}{% endblock %}
+{% block content %}
+<div class="page-header">
+  <div>
+    <h1>{{ sheet.user.name }}'s timesheet</h1>
+    <div class="subtitle">
+      Week of {{ sheet.week_start.strftime('%d %b %Y') }}
+      &middot; <span class="badge status-{{ sheet.status }}">{{ sheet.status }}</span>
+      {% if sheet.is_reviewed %}&middot; Reviewed by {{ sheet.reviewed_by.name }} on {{ sheet.reviewed_at.strftime('%d %b %Y') }}{% endif %}
+    </div>
+  </div>
+  <div>
+    <a href="{{ url_for('hr.list_timesheets') }}" class="btn secondary">Back to Time Sheets</a>
+  </div>
+</div>
+
+<div class="stat-grid">
+  <div class="stat-card"><div class="num">{{ sheet.total_hours }}</div><div class="label">Total hours</div></div>
+  <div class="stat-card"><div class="num">{{ sheet.regular_hours }}</div><div class="label">Regular hours</div></div>
+  <div class="stat-card{% if sheet.overtime_hours > 0 %} danger{% endif %}"><div class="num">{{ sheet.overtime_hours }}</div><div class="label">Overtime hours</div></div>
+</div>
+
+{% if can_edit %}
+<div class="card">
+  <h3 class="mt-0">Add an entry</h3>
+  <form method="post" action="{{ url_for('hr.add_time_entry', timesheet_id=sheet.id) }}" class="form-row" style="align-items:flex-end;">
+    <div>
+      <label for="work_date">Date</label>
+      <select id="work_date" name="work_date">
+        {% for d in week_dates %}<option value="{{ d.isoformat() }}">{{ d.strftime('%a %d %b') }}</option>{% endfor %}
+      </select>
+    </div>
+    <div>
+      <label for="engagement_id">Engagement (optional)</label>
+      <select id="engagement_id" name="engagement_id">
+        <option value="">General / non-billable</option>
+        {% for e in engagements %}<option value="{{ e.id }}">{{ e.client.name }} - {{ e.title }}</option>{% endfor %}
+      </select>
+    </div>
+    <div><label for="description">Description</label><input type="text" id="description" name="description" placeholder="e.g. Fieldwork - cash testing"></div>
+    <div><label for="hours">Hours</label><input type="number" id="hours" name="hours" step="0.25" min="0.25" max="24" required></div>
+    <div><button type="submit" class="btn gold" style="margin-bottom:14px;">Add entry</button></div>
+  </form>
+  <p class="muted" style="font-size:12px;">Any hours beyond {{ 8 }} on a single day are automatically counted as overtime.</p>
+</div>
+{% endif %}
+
+<div class="card">
+  {% if sheet.entries %}
+  <table>
+    <thead><tr><th>Date</th><th>Engagement</th><th>Description</th><th>Hours</th><th>Regular</th><th>Overtime</th>{% if can_edit %}<th></th>{% endif %}</tr></thead>
+    <tbody>
+    {% for e in sheet.entries %}
+      <tr>
+        <td>{{ e.work_date.strftime('%a %d %b') }}</td>
+        <td class="muted">{{ e.engagement.title if e.engagement else 'General / non-billable' }}</td>
+        <td class="muted">{{ e.description or '—' }}</td>
+        <td>{{ e.hours }}</td>
+        <td>{{ e.regular_hours }}</td>
+        <td>{{ e.overtime_hours }}</td>
+        {% if can_edit %}
+        <td><form method="post" action="{{ url_for('hr.delete_time_entry', entry_id=e.id) }}" class="inline" onsubmit="return confirm('Delete this entry?')"><button type="submit" class="btn small danger">Delete</button></form></td>
+        {% endif %}
+      </tr>
+    {% endfor %}
+    </tbody>
+  </table>
+  {% else %}
+  <div class="empty-state">No hours logged yet.</div>
+  {% endif %}
+</div>
+
+{% if can_review %}
+<div class="card">
+  <h3 class="mt-0">Review</h3>
+  {% if sheet.status == 'Approved' %}
+  <p class="muted" style="font-size:13px;">Approved by {{ sheet.reviewed_by.name }} on {{ sheet.reviewed_at.strftime('%d %b %Y') }}.</p>
+  <form method="post" action="{{ url_for('hr.unapprove_timesheet', timesheet_id=sheet.id) }}"><button type="submit" class="btn secondary">Reopen for editing</button></form>
+  {% else %}
+  <form method="post" action="{{ url_for('hr.approve_timesheet', timesheet_id=sheet.id) }}"><button type="submit" class="btn gold">Approve timesheet</button></form>
+  {% endif %}
+</div>
+{% endif %}
+{% endblock %}
diff --git a/templates/hr/timesheets_list.html b/templates/hr/timesheets_list.html
new file mode 100644
index 0000000..6161bd8
--- /dev/null
+++ b/templates/hr/timesheets_list.html
@@ -0,0 +1,107 @@
+{% extends "base.html" %}
+{% block title %}Time Sheets - {{ firm_name }}{% endblock %}
+{% block content %}
+<div class="page-header">
+  <div>
+    <h1>Time Sheets</h1>
+    <div class="subtitle">Log hours in the app (overtime is calculated automatically), or fill in the Excel template offline and upload it back.</div>
+  </div>
+</div>
+
+<div class="card">
+  <div class="form-row">
+    <div>
+      <h3 class="mt-0">Start a new timesheet</h3>
+      <form method="post" action="{{ url_for('hr.new_timesheet') }}" style="margin-bottom:0;">
+        <label for="week_start">Week starting (Monday)</label>
+        <input type="date" id="week_start" name="week_start" value="{{ default_week }}">
+        <button type="submit" class="btn gold">Start / open timesheet</button>
+      </form>
+    </div>
+    <div>
+      <h3 class="mt-0">Prefer Excel?</h3>
+      <p class="muted" style="font-size:13px;">Download the template - it auto-computes your daily regular and overtime hours - fill it in, then upload the completed file below.</p>
+      <a href="{{ url_for('static', filename='downloads/Neverlank_Timesheet_Template.xlsx') }}" class="btn secondary">Download Excel template</a>
+    </div>
+  </div>
+</div>
+
+<div class="card">
+  <h3 class="mt-0">My timesheets</h3>
+  {% if my_sheets %}
+  <table>
+    <thead><tr><th>Week of</th><th>Total hours</th><th>Regular</th><th>Overtime</th><th>Status</th><th></th></tr></thead>
+    <tbody>
+      {% for s in my_sheets %}
+      <tr>
+        <td>{{ s.week_start.strftime('%d %b %Y') }}</td>
+        <td>{{ s.total_hours }}</td>
+        <td>{{ s.regular_hours }}</td>
+        <td>{{ s.overtime_hours }}</td>
+        <td><span class="badge status-{{ s.status }}">{{ s.status }}</span></td>
+        <td class="text-right"><a href="{{ url_for('hr.view_timesheet', timesheet_id=s.id) }}" class="btn small secondary">Open</a></td>
+      </tr>
+      {% endfor %}
+    </tbody>
+  </table>
+  {% else %}
+  <div class="empty-state">No timesheets yet - start one above.</div>
+  {% endif %}
+</div>
+
+<div class="card">
+  <h3 class="mt-0">Upload a completed timesheet</h3>
+  <form method="post" action="{{ url_for('hr.upload_timesheet') }}" enctype="multipart/form-data" class="form-row" style="align-items:flex-end;">
+    <div><label for="period_label">Period</label><input type="text" id="period_label" name="period_label" placeholder="e.g. Week of 14 Sep 2026"></div>
+    <div><label for="file">File (.xlsx, .xls or .pdf)</label><input type="file" id="file" name="file" accept=".xlsx,.xls,.pdf" required></div>
+    <div><button type="submit" class="btn gold" style="margin-bottom:14px;">Upload</button></div>
+  </form>
+  {% if uploads %}
+  <table>
+    <thead><tr><th>File</th><th>Period</th>{% if current_user.role in ('supervisor', 'partner', 'admin') %}<th>Staff</th>{% endif %}<th>Uploaded</th><th></th></tr></thead>
+    <tbody>
+      {% for u in uploads %}
+      <tr>
+        <td>{{ u.original_filename }}</td>
+        <td class="muted">{{ u.period_label or '—' }}</td>
+        {% if current_user.role in ('supervisor', 'partner', 'admin') %}<td>{{ u.user.name }}</td>{% endif %}
+        <td class="muted">{{ u.uploaded_at.strftime('%d %b %Y %H:%M') }}</td>
+        <td class="text-right">
+          <a href="{{ url_for('hr.download_timesheet_upload', upload_id=u.id) }}" class="btn small secondary">Download</a>
+          <form method="post" action="{{ url_for('hr.delete_timesheet_upload', upload_id=u.id) }}" class="inline" onsubmit="return confirm('Delete this upload?')"><button type="submit" class="btn small danger">Delete</button></form>
+        </td>
+      </tr>
+      {% endfor %}
+    </tbody>
+  </table>
+  {% else %}
+  <div class="empty-state">No uploaded timesheets yet.</div>
+  {% endif %}
+</div>
+
+{% if current_user.role in ('supervisor', 'partner', 'admin') %}
+<div class="card">
+  <h3 class="mt-0">Team timesheets</h3>
+  {% if team_sheets %}
+  <table>
+    <thead><tr><th>Staff</th><th>Week of</th><th>Total hours</th><th>Regular</th><th>Overtime</th><th>Status</th><th></th></tr></thead>
+    <tbody>
+      {% for s in team_sheets %}
+      <tr>
+        <td>{{ s.user.name }}</td>
+        <td>{{ s.week_start.strftime('%d %b %Y') }}</td>
+        <td>{{ s.total_hours }}</td>
+        <td>{{ s.regular_hours }}</td>
+        <td>{{ s.overtime_hours }}</td>
+        <td><span class="badge status-{{ s.status }}">{{ s.status }}</span></td>
+        <td class="text-right"><a href="{{ url_for('hr.view_timesheet', timesheet_id=s.id) }}" class="btn small secondary">Open</a></td>
+      </tr>
+      {% endfor %}
+    </tbody>
+  </table>
+  {% else %}
+  <div class="empty-state">No team timesheets submitted yet.</div>
+  {% endif %}
+</div>
+{% endif %}
+{% endblock %}
