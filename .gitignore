venv/
__pycache__/
*.pyc
instance/*.db
instance/*.db-shm
instance/*.db-wal
uploads/*
!uploads/.gitkeep
# The smoke_test_*.py files ARE kept in the repo now: the GitHub "Tests" workflow
# (.github/workflows/tests.yml) runs them on every push. They are harmless on Render
# (nothing imports them).
document_templates_data/
build/
dist/
*.spec
NeverlankApp.exe
.env
# Offline pip wheels bundled only for the Windows/.exe distribution zip -
# not needed for cloud hosting (Render installs from PyPI directly), and
# keeping it out of git keeps the repo small and pushes fast.
wheelhouse/
# Old drafts, zips and numbered copies (app-1.py, detail-6.html ...) are kept for reference only - never part of the app
Claude outputs/
*-[0-9].py
*-[0-9].html
*.zip
